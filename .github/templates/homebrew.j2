      <td><code>{{ app.version }}</code></td>
      <td>{{ app.license }}</td>
      <td><a href="{{ app.name }}.rb">Cask</a></td>
    </tr>
    <tr>
      <td colspan="5">
        <pre><code>brew install {{ env['ORG'] }}/{{ env['REPO'] }}/{{ app.name }}</code></pre>
      </td>
    </tr>
  {%- endfor %}
  </tbody>
</table>
